<div class="content">
  {# {% include pagination-newer.html %} #}

  {# {{ content }} #}

  {%- for post in postslist | reverse %}
  <article class="post-body">
    <h2 class="post-title">
      <a href="{{ post.url  }}">
        {{ post.data.title }}
      </a>
    </h2>

    {% set date = post.data.date %}
    {% include "post-meta.njk" %}

    {% if post.data.excerpt %}
      <p>{{ post.data.excerpt }}</p>
    {% endif %}
  </article>
  {% endfor %}

  {# {% include pagination-older.html %} #}
</div>
